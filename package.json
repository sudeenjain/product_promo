{
  "name": "campco-dark-delight-scroll",
  "version": "1.0.0",
  "private": true,
  "description": "Scroll-driven three.js product page for Campco Dark Delight",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --loader:.jpg=dataurl --outfile=js/app.js",
    "dev": "esbuild src/main.js --bundle --format=iife --loader:.jpg=dataurl --outfile=js/app.js --watch --servedir=."
  },
  "dependencies": { "three": "0.160.1" },
  "devDependencies": { "esbuild": "0.21.5" }
}
